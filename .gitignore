# ---- credentials: never commit ----------------------------------------------------------------
.hf_token
*.token

# ---- raw data and model inputs: live under $ANTHEIA_DATA (default /scratch/cher/antheia-data) ---
rawplantsdata/
rawpollinatordata/
*.parquet
*.zip
*.gz
*.pt
*.ckpt

# ---- built inputs: regenerate with pipelines/ (only the frozen splits and the universe are committed)
data/network/*.parquet
data/features/
artifacts/cache/
artifacts/external/
!data/splits/

# ---- experiment outputs: bundles under runs/ are the record and live outside git --------------
runs/
runs_archive/
logs/
results/*.npy
results/*.npz
results/scores_*
results/**/*.npy
results/**/*.npz

# ---- python / notebooks ------------------------------------------------------------------------
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
